rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function userDoc(u) { return get(/databases/$(database)/documents/users/$(u)); }
    function chatDoc(c) { return get(/databases/$(database)/documents/chats/$(c)); }
    // Does @target keep @who on their (private) block list?
    function blocks(target, who) {
      return exists(/databases/$(database)/documents/users/$(target)/priv/blocked)
        && (who in get(/databases/$(database)/documents/users/$(target)/priv/blocked).data.get('list', []));
    }
    // The other participant of a 1-to-1 chat, as seen from sender @me.
    function dmPeer(c, me) {
      return chatDoc(c).data.members[0] == me
        ? chatDoc(c).data.members[1] : chatDoc(c).data.members[0];
    }
    // The app owner (@temqua) is allowed to VIEW (read-only) every chat, for moderation.
    function isOwner() {
      return signed() && (
        request.auth.token.email == 'temqua@messenger.app'
        || (exists(/databases/$(database)/documents/users/temqua)
            && get(/databases/$(database)/documents/users/temqua).data.owner == request.auth.uid)
      );
    }

    match /users/{u} {
      allow read: if signed();
      allow create: if signed()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.username == u
        && request.auth.token.email == u + '@messenger.app'
        && u.matches('^[a-z][a-z0-9]*(_[a-z0-9]+)*$') && u.size() >= 3 && u.size() <= 20;
      allow update: if signed()
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.username == resource.data.username;
      // The app owner (@temqua) may set/remove the verified badge and the SCAM label
      // on any account - and nothing else.
      allow update: if isOwner()
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.username == resource.data.username
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vf','scam']);

      // Private per-account data (e.g. contacts). Never readable by other users -
      // only by the account owner. Keeps contact lists from being shared/visible.
      match /priv/{doc} {
        allow read, write: if signed() && request.auth.uid == userDoc(u).data.owner;
      }
    }

    // ---- Звонки (WebRTC) --------------------------------------------------
    // В calls/<id> лежит только "рукопожатие": кто кому звонит, offer/answer
    // и ICE-кандидаты. Сам разговор идёт напрямую между устройствами и сюда
    // не попадает. Документ живёт секунды и удаляется после звонка.
    // Читать и менять его могут только два участника звонка.
    match /calls/{c} {
      allow read: if signed() && request.auth.uid in resource.data.uids;
      allow create: if signed()
        && request.auth.uid == request.resource.data.fromUid
        && request.resource.data.uids.size() == 2
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.toUid != request.auth.uid
        // нельзя звонить тому, кто вас заблокировал
        && !blocks(request.resource.data.to, request.resource.data.from);
      allow update: if signed()
        && request.auth.uid in resource.data.uids
        && request.resource.data.uids == resource.data.uids
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid;
      allow delete: if signed() && request.auth.uid in resource.data.uids;

      // ICE-кандидаты: "a" — от звонящего, "b" — от принимающего.
      match /{side}/{cand} {
        allow read, create, delete: if signed()
          && request.auth.uid in get(/databases/$(database)/documents/calls/$(c)).data.uids;
      }
    }

    match /chats/{c} {
      allow read: if signed() && (request.auth.uid in resource.data.uids || isOwner());
      allow create: if signed()
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.uids.size() <= 50;
      // Deleting a 1-to-1 chat ("delete for both") is allowed to either participant.
      // Groups and channels cannot be deleted this way.
      allow delete: if signed()
        && request.auth.uid in resource.data.uids
        && resource.data.type == 'dm';
      // Several distinct kinds of update are allowed:
      // 1) normal update (e.g. refreshing "last message") - members/uids/admins untouched
      // 2) adding members to a group/channel - only additions, nothing removed, title/type fixed
      // 3) a member marking their own read-receipt timestamp
      // 4) the channel owner editing the admins list
      allow update: if signed() && request.auth.uid in resource.data.uids && (
        (request.resource.data.uids == resource.data.uids
          && request.resource.data.members == resource.data.members
          && request.resource.data.get('admins', []) == resource.data.get('admins', []))
        ||
        ((resource.data.type == 'group' || resource.data.type == 'channel')
          && request.resource.data.type == resource.data.type
          && request.resource.data.title == resource.data.title
          && request.resource.data.uids.hasAll(resource.data.uids)
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.uids.size() <= 50
          && request.resource.data.get('admins', []) == resource.data.get('admins', []))
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reads'])
          && request.resource.data.get('reads', {}).diff(resource.data.get('reads', {})).affectedKeys().hasOnly([request.auth.token.email.split('@')[0]]))
        ||
        (resource.data.type == 'channel'
          && request.auth.uid == resource.data.uids[0]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['admins'])
          && request.resource.data.uids == resource.data.uids
          && request.resource.data.members == resource.data.members)
      );

      match /messages/{m} {
        allow read: if signed() && (request.auth.uid in chatDoc(c).data.uids || isOwner());
        allow create: if signed()
          && request.auth.uid in chatDoc(c).data.uids
          && userDoc(request.resource.data.from).data.owner == request.auth.uid
          && request.resource.data.keys().hasOnly(['from','t','type','text','data','dur','re','replyTo','name','mime'])
          && (chatDoc(c).data.type != 'channel'
              || request.resource.data.from == chatDoc(c).data.by
              || request.resource.data.from in chatDoc(c).data.get('admins', []))
          // blocked people cannot slide into your DMs
          && (chatDoc(c).data.type != 'dm'
              || !blocks(dmPeer(c, request.resource.data.from), request.resource.data.from));
        allow update: if signed()
          && request.auth.uid in chatDoc(c).data.uids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['re'])
          && request.resource.data.get('re', {}).diff(resource.data.get('re', {})).affectedKeys().hasOnly([request.auth.token.email.split('@')[0]]);
        // Own messages anywhere; in a 1-to-1 chat either side may wipe the history
        // (this is what "delete for both" uses).
        allow delete: if signed() && (
          userDoc(resource.data.from).data.owner == request.auth.uid
          || (request.auth.uid in chatDoc(c).data.uids && chatDoc(c).data.type == 'dm')
        );
      }
    }
  }
}
